{
  "name": "@gitcms/cli",
  "version": "0.1.0",
  "description": "Command line tools for GitCMS",
  "bin": {
    "gitcms": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format cjs --dts",
    "dev": "tsup src/cli.ts src/index.ts --format cjs --dts --watch",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@gitcms/core": "*"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "eslint": "^9.15.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "cms",
    "github",
    "cli",
    "command-line"
  ]
}
