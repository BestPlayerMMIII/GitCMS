/**
 * GitCMS Client - Transport Modes Examples
 * 
 * This file demonstrates the three transport modes and when to use each.
 */

import { GitCMS } from '@git-cms/client';

// ============================================================================
// EXAMPLE 1: PUBLIC MODE (No Token Required)
// ============================================================================
// Best for: Public repositories, client-side applications, simple blogs

export function publicModeExample() {
  // Initialize without token - completely safe for client-side
  const cms = new GitCMS({
    repository: 'username/blog',
    // No token needed!
  });

  // Verify we're in public mode
  console.log('Transport mode:', cms.getTransportMode()); // 'public'
  console.log('Is public:', cms.isPublicMode()); // true

  return cms;
}

// Usage in React component
export async function BlogList() {
  const cms = publicModeExample();
  
  // Fetch all published posts
  const posts = await cms
    .from('posts')
    .where('metadata.status', '==', 'published')
    .orderBy('metadata.publishedAt', 'desc')
    .get();

  return (
    <div>
      {posts.map(post => (
        <article key={post.id}>
          <h2>{post.title}</h2>
          <p>{post.excerpt}</p>
        </article>
      ))}
    </div>
  );
}

// ============================================================================
// EXAMPLE 2: AUTHENTICATED MODE (Token Required, Server-Side Only)
// ============================================================================
// Best for: Private repositories, higher rate limits, server-side applications

export function authenticatedModeExample() {
  // Server-side only! Never use in client-side code
  const cms = new GitCMS({
    repository: 'company/private-content',
    token: process.env.GITHUB_TOKEN, // From environment variable
  });

  // Verify we're in authenticated mode
  console.log('Transport mode:', cms.getTransportMode()); // 'authenticated'
  console.log('Is public:', cms.isPublicMode()); // false

  return cms;
}

// Usage in Next.js Server Component
export async function ProductsPage() {
  const cms = authenticatedModeExample();
  
  // Fetch products from private repository
  const products = await cms
    .from('products')
    .where('data.inStock', true)
    .orderBy('data.price', 'asc')
    .get();

  return (
    <div>
      {products.map(product => (
        <div key={product.id}>
          <h3>{product.name}</h3>
          <p>${product.price}</p>
        </div>
      ))}
    </div>
  );
}

// Check rate limits (authenticated mode)
export async function checkRateLimits() {
  const cms = authenticatedModeExample();
  
  const rateLimit = await cms.getRateLimit();
  if (rateLimit) {
    console.log(`Requests remaining: ${rateLimit.remaining}/${rateLimit.limit}`);
    console.log(`Resets at: ${rateLimit.reset}`);
    console.log(`Used: ${rateLimit.used}`);
    
    // Warn if approaching limit
    if (rateLimit.remaining < 100) {
      console.warn('⚠️ Approaching rate limit! Consider implementing caching.');
    }
  }
}

// ============================================================================
// EXAMPLE 3: PROXY MODE (Custom API Endpoint)
// ============================================================================
// Best for: High-traffic sites, custom caching, additional processing

export function proxyModeExample() {
  // Use your custom API endpoint
  const cms = new GitCMS({
    repository: 'username/blog',
    baseUrl: 'https://api.mysite.com',
    token: 'optional-api-key', // For your API, not GitHub
  });

  // Verify we're in proxy mode
  console.log('Transport mode:', cms.getTransportMode()); // 'proxy'

  return cms;
}

// Custom API endpoint (example)
export async function GET(request: Request) {
  const { searchParams } = new URL(request.url);
  const schema = searchParams.get('schema') || 'posts';

  // Server-side CMS with actual GitHub token
  const cms = new GitCMS({
    repository: 'username/blog',
    token: process.env.GITHUB_TOKEN,
  });

  // Add caching layer (example with Redis)
  const cacheKey = `content:${schema}`;
  // const cached = await redis.get(cacheKey);
  // if (cached) return Response.json(JSON.parse(cached));

  // Fetch from GitHub
  const items = await cms.from(schema).get();

  // Cache for 5 minutes
  // await redis.set(cacheKey, JSON.stringify(items), { ex: 300 });

  return Response.json(items);
}

// ============================================================================
// EXAMPLE 4: EXPLICIT TRANSPORT MODE
// ============================================================================
// Force a specific transport mode, overriding auto-detection

export function explicitModeExample() {
  // Force public mode even with a token present
  const cms = new GitCMS({
    repository: 'username/blog',
    token: 'ghp_xxx', // Present but won't be used
    transport: 'public', // Explicitly use public mode
  });

  console.log('Transport mode:', cms.getTransportMode()); // 'public'
  
  return cms;
}

// ============================================================================
// EXAMPLE 5: HYBRID APPROACH (Client + Server)
// ============================================================================
// Use different modes for different parts of your app

// Client-side: Public mode for published content
export const clientCMS = new GitCMS({
  repository: 'username/blog',
  // No token - safe for browsers
});

// Server-side: Authenticated mode for drafts and admin
export const serverCMS = new GitCMS({
  repository: 'username/blog',
  token: process.env.GITHUB_TOKEN,
  // Server-side only!
});

// Client-side component
export async function PublicBlog() {
  // Use public mode for published posts
  const posts = await clientCMS
    .from('posts')
    .where('metadata.status', '==', 'published')
    .get();

  return <PostList posts={posts} />;
}

// Server-side component
export async function AdminDashboard() {
  // Use authenticated mode to see drafts
  const drafts = await serverCMS
    .from('posts')
    .where('metadata.status', '==', 'draft')
    .get();

  const published = await serverCMS
    .from('posts')
    .where('metadata.status', '==', 'published')
    .get();

  return (
    <div>
      <h2>Drafts ({drafts.length})</h2>
      <DraftsList drafts={drafts} />
      
      <h2>Published ({published.length})</h2>
      <PublishedList posts={published} />
    </div>
  );
}

// ============================================================================
// EXAMPLE 6: STATIC SITE GENERATION
// ============================================================================
// Fetch content at build time (no runtime API calls)

export async function generateStaticData() {
  const cms = new GitCMS({
    repository: 'username/blog',
    // No token needed for public repo
  });

  // Fetch all content at build time
  const posts = await cms.from('posts').get();
  const pages = await cms.from('pages').get();
  const config = await cms.doc('site-config').get();

  // Return for static generation
  return {
    posts,
    pages,
    config,
  };
}

// Next.js usage
export async function generateStaticParams() {
  const cms = new GitCMS({
    repository: 'username/blog',
  });

  const posts = await cms.from('posts').get();

  return posts.map(post => ({
    slug: post.id,
  }));
}

// ============================================================================
// EXAMPLE 7: ERROR HANDLING
// ============================================================================

export async function robustFetching() {
  const cms = new GitCMS({
    repository: 'username/blog',
  });

  try {
    // Check rate limit before making requests
    const rateLimit = await cms.getRateLimit();
    if (rateLimit && rateLimit.remaining < 5) {
      throw new Error('Rate limit nearly exhausted');
    }

    // Fetch content
    const posts = await cms.from('posts').get();
    return posts;
  } catch (error) {
    console.error('Failed to fetch content:', error);
    
    // Fallback to cached data or show error
    return [];
  }
}

// ============================================================================
// EXAMPLE 8: PROGRESSIVE ENHANCEMENT
// ============================================================================

export async function progressiveLoading() {
  // 1. Fast initial load with public mode (cached or recent posts)
  const publicCMS = new GitCMS({
    repository: 'username/blog',
  });

  const recentPosts = await publicCMS
    .from('posts')
    .where('metadata.status', '==', 'published')
    .orderBy('metadata.publishedAt', 'desc')
    .limit(5)
    .get();

  // Show recent posts immediately
  console.log('Initial load:', recentPosts.length, 'posts');

  // 2. Load more via proxy (with caching)
  const proxyCMS = new GitCMS({
    repository: 'username/blog',
    baseUrl: '/api/cms',
  });

  const allPosts = await proxyCMS.from('posts').get();
  console.log('Full load:', allPosts.length, 'posts');

  return { recentPosts, allPosts };
}

// ============================================================================
// EXAMPLE 9: MEDIA HANDLING WITH TRANSPORT MODES
// ============================================================================

export async function mediaExample() {
  const cms = new GitCMS({
    repository: 'username/blog',
    // Public mode for public media
  });

  // Fetch post with media
  const post = await cms.from('posts').doc('my-post').get();

  // Extract media references
  const mediaRefs = cms.media.extractFromHTML(post.content);
  console.log('Found', mediaRefs.length, 'media items');

  // Get thumbnails (fast, synchronous)
  const thumbnails = mediaRefs.map(ref => ({
    path: ref.path,
    thumbnail: cms.media.getThumbnail(ref),
  }));

  // Fetch full resolution (async, progressive)
  for (const ref of mediaRefs) {
    const fullMedia = await cms.media.fetchFull(ref);
    console.log('Loaded:', fullMedia.reference.filename);
  }

  return { post, mediaRefs, thumbnails };
}

// ============================================================================
// EXAMPLE 10: MONITORING AND DEBUGGING
// ============================================================================

export async function monitoringExample() {
  const cms = new GitCMS({
    repository: 'username/blog',
    token: process.env.GITHUB_TOKEN,
  });

  // Get transport mode info
  console.log('Transport:', cms.getTransportMode());
  console.log('Public mode:', cms.isPublicMode());

  // Monitor rate limits
  const rateLimit = await cms.getRateLimit();
  if (rateLimit) {
    console.log({
      limit: rateLimit.limit,
      remaining: rateLimit.remaining,
      used: rateLimit.used,
      reset: rateLimit.reset,
      percentUsed: (rateLimit.used / rateLimit.limit) * 100,
    });
  }

  // Test connection
  try {
    const testPost = await cms.from('posts').limit(1).get();
    console.log('✅ Connection successful');
  } catch (error) {
    console.error('❌ Connection failed:', error);
  }
}

// ============================================================================
// ANTI-PATTERNS (What NOT to do)
// ============================================================================

// ❌ NEVER: Expose token in client-side code
export function BAD_clientSideWithToken() {
  const cms = new GitCMS({
    repository: 'username/blog',
    token: 'ghp_xxxxxxxxxxxxx', // NEVER DO THIS!
  });
  // This token is visible in browser network tab!
}

// ❌ NEVER: Use authenticated mode client-side
export function BAD_authenticatedInBrowser() {
  const cms = new GitCMS({
    repository: 'username/private-blog',
    token: process.env.GITHUB_TOKEN, // Won't work in browser!
  });
  // Environment variables aren't available in browser
}

// ❌ AVOID: Creating unnecessary API endpoints for public repos
export function BAD_unnecessaryProxy() {
  // If your repo is public, don't do this:
  const cms = new GitCMS({
    repository: 'username/blog',
    baseUrl: '/api/cms', // Unnecessary for public repos
  });
  
  // Just use public mode instead:
  // const cms = new GitCMS({ repository: 'username/blog' });
}

// ✅ GOOD: Use public mode for public repos
export function GOOD_publicMode() {
  const cms = new GitCMS({
    repository: 'username/blog',
    // Simple, safe, no backend needed
  });
  return cms;
}

// ✅ GOOD: Use authenticated mode server-side only
export function GOOD_authenticatedMode() {
  if (typeof window !== 'undefined') {
    throw new Error('Authenticated mode must be server-side only!');
  }
  
  const cms = new GitCMS({
    repository: 'username/private-blog',
    token: process.env.GITHUB_TOKEN,
  });
  return cms;
}

// ✅ GOOD: Use proxy mode for high-traffic or advanced features
export function GOOD_proxyMode() {
  const cms = new GitCMS({
    repository: 'username/blog',
    baseUrl: 'https://api.mysite.com',
    // Your API handles caching, rate limiting, etc.
  });
  return cms;
}
