{
  "name": "@gitcms/client",
  "version": "0.1.0",
  "description": "TypeScript SDK for GitCMS",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@gitcms/core": "*"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "eslint": "^9.15.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "cms",
    "github",
    "typescript",
    "content-management",
    "sdk"
  ]
}
