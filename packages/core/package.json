{
  "name": "@git-cms/core",
  "version": "0.1.2",
  "description": "Core utilities and types for GitCMS",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@octokit/auth-token": "^6.0.0",
    "@octokit/rest": "^22.0.0",
    "gray-matter": "^4.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "bundle-require": "^5.1.0",
    "cac": "^6.7.14",
    "chokidar": "^4.0.3",
    "consola": "^3.4.2",
    "eslint": "^9.15.0",
    "fix-dts-default-cjs-exports": "^1.0.1",
    "joycon": "^3.1.1",
    "picocolors": "^1.1.1",
    "postcss-load-config": "^6.0.1",
    "resolve-from": "^5.0.0",
    "source-map": "^0.8.0-beta.0",
    "sucrase": "^3.35.1",
    "tinyexec": "^0.3.2",
    "tinyglobby": "^0.2.15",
    "tree-kill": "^1.2.2",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "src/data"
  ],
  "keywords": [
    "cms",
    "github",
    "typescript",
    "utilities"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BestPlayerMMIII/GitCMS.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/BestPlayerMMIII/GitCMS/issues"
  },
  "homepage": "https://github.com/BestPlayerMMIII/GitCMS#readme",
  "license": "MIT",
  "author": {
    "name": "Manuel Maiuolo - BestPlayerMMIII",
    "url": "https://github.com/BestPlayerMMIII"
  },
  "publishConfig": {
    "access": "public"
  }
}
